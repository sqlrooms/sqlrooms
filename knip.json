{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreDependencies": ["identity-obj-proxy", "jest-environment-node"],
  "ignore": [
    "python/**",
    "docs/**",
    "examples/app-builder/app-scaffolds/**",
    "apps/sqlrooms-cli-ui/app-scaffolds/get-started/**"
  ],
  "exclude": ["exports", "types", "duplicates"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": [
        "@types/*",
        "@lerna-lite/*",
        "glob",
        "mermaid",
        "remove",
        "vitepress-plugin-llms",
        "typescript-language-server"
      ],
      "ignoreBinaries": [
        "uv",
        "apps/sqlrooms-cli-ui/evals/promptfooconfig.yaml"
      ]
    },
    "packages/*": {
      "entry": ["src/index.{ts,tsx}"]
    },
    "packages/artifacts": {
      "ignoreDependencies": ["ts-jest"]
    },
    "packages/evals": {
      "entry": ["src/promptfoo/export.ts"]
    },
    "packages/preset-jest": {
      "entry": ["*.js"],
      "ignoreDependencies": ["@testing-library/*", "jest-environment-jsdom"]
    },
    "packages/preset-eslint": {
      "entry": ["*.js"]
    },
    "packages/preset-typedoc": {
      "entry": ["*.js"]
    },
    "packages/preset-typescript": {
      "entry": ["*.json"]
    },
    "examples/*nextjs*": {
      "entry": ["src/app/**/{page.tsx,api/**/*.ts}"]
    },
    "examples/*": {
      "entry": ["src/main.{ts,tsx}"]
    },
    "apps/*": {},
    "apps/sqlrooms-cli-ui": {
      "entry": ["src/main.{ts,tsx}", "src/evals/promptfooProvider.ts"],
      "ignoreDependencies": ["@duckdb/node-api"]
    }
  }
}
