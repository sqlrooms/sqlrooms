    "@sqlrooms/data-table": "workspace:*",
    "@sqlrooms/db": "workspace:*",
    "@sqlrooms/documents": "workspace:*",
    "@sqlrooms/duckdb": "workspace:*",
    "@sqlrooms/mcp": "workspace:*",
    "@sqlrooms/mosaic": "workspace:*",
    "@sqlrooms/room-shell": "workspace:*",
    "@sqlrooms/room-store": "workspace:*",
    "@sqlrooms/schema-tree": "workspace:*",
    "@sqlrooms/ui": "workspace:*",
    "@sqlrooms/utils": "workspace:*",
    "@uwdata/mosaic-core": "^0.21.0",
    "@uwdata/mosaic-sql": "^0.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
